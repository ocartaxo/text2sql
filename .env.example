# .env.example

# --- LLM Provider ---
# Padrão gratuito recomendado: Google AI Studio
LLM_MODEL=google-gla:gemini-3.8-flash
GEMINI_API_KEY=

# Provedor secundário opcional (fallback / benchmark)
# LLM_MODEL=groq:qwen/qwen3-32b
GROQ_API_KEY=

# --- PostgreSQL (Docker Compose & App) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev_admin_password
POSTGRES_DB=text2sql_ci
POSTGRES_PORT=5432

# Role somente leitura criada em docker/postgres/02_roles_and_rls.sql
RO_DB_PASSWORD=change_me_in_prod_ro
RO_DATABASE_URL=postgresql://text2sql_ro:change_me_in_prod_ro@127.0.0.1:5432/text2sql_ci

# --- API & Agent Limits ---
API_PORT=8000
AGENT_REQUEST_LIMIT=8
AGENT_TOTAL_TOKENS_LIMIT=24000

# --- Observability (OpenTelemetry / Grafana OTEL-LGTM / Langfuse) ---
ENABLE_OTEL=false
OTEL_SERVICE_NAME=text2sql-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# Para Langfuse OTLP, configure: OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(pk:sk)>
OTEL_EXPORTER_OTLP_HEADERS=

# --- Prompt Regression Evals ---
EVAL_DATABASE_URL=postgresql://text2sql_ro:change_me_in_prod_ro@127.0.0.1:5432/text2sql_ci
EVAL_MODEL=google-gla:gemini-3.8-flash
EVAL_TIER=smoke
EVAL_MIN_ACCURACY=0.85
EVAL_PACING_SECONDS=2.0